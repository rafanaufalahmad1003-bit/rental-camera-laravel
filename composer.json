{
  "name": "student/rental-camera",
  "type": "project",
  "description": "Mini project Rental Camera with Laravel",
  "require": {"php": "^8.3", "laravel/framework": "^13.0"},
  "require-dev": {"fakerphp/faker": "^1.23"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"], "post-create-project-cmd": ["@php artisan key:generate --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable", "prefer-stable": true
}
